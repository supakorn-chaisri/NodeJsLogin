NODE_ENV=development
PORT=3000
WEB_PORT=8080
WEB_BIND_ADDRESS=127.0.0.1

POSTGRES_USER=account
POSTGRES_PASSWORD=local-only-change-me
POSTGRES_DB=account
DATABASE_URL=postgresql://account:local-only-change-me@localhost:5432/account?schema=public

# Compose uses http://localhost:8080. For the Angular dev server, use http://localhost:4200.
APP_ORIGIN=http://localhost:8080
CSRF_SECRET=replace-with-at-least-32-random-characters
RATE_LIMIT_SECRET=replace-with-a-different-32-character-secret
TRUST_PROXY=false

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@example.test
SMTP_SECURE=false

# Optional. Set both client values and register the callback URL in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:8080/api/auth/google/callback

# Only needed when running the bootstrap-admin command.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
